#, php-format
msgid "%s data rows detected. Extra columns: %s."
msgstr "检测到 %s 行数据。额外列：%s。"

#, php-format
msgid "%s of %s entered"
msgstr "已录入 %s / %s"

#, php-format
msgid "%s: %s/%s rows matched as %s."
msgstr "%s：%s/%s 行匹配为 %s。"

msgid "A recognised header row was detected and skipped."
msgstr "已识别并跳过标题行。"

msgid "All Classes"
msgstr "所有课程"

msgid "Ambiguous student"
msgstr "学生匹配不唯一"

#, php-format
msgid "Apply %s changed student rows to the private draft?"
msgstr "将 %s 名学生的变更应用到私有草稿吗？"

msgid "Apply to Draft"
msgstr "应用到草稿"

msgid "Assessment Date"
msgstr "评估日期"

msgid "Assessment Scale"
msgstr "评估评分标准"

msgid "Assessment published."
msgstr "评估已发布。"

msgid "Back to Draft"
msgstr "返回草稿"

msgid "CSV or XLSX File"
msgstr "CSV 或 XLSX 文件"

msgid "Choose a CSV/XLSX file or paste a table."
msgstr "请选择 CSV/XLSX 文件或粘贴表格。"

msgid "Choose a grade from the selected scale."
msgstr "请从所选评分量表中选择一个等级。"

msgid "Choose a valid assessment date."
msgstr "请选择有效的评估日期。"

msgid "Choose a valid assessment type."
msgstr "请选择有效的评估类型。"

msgid "Choose a valid parent visibility setting."
msgstr "请选择有效的家长可见设置。"

msgid "Choose a valid student visibility setting."
msgstr "请选择有效的学生可见设置。"

msgid "Choose how the identifier and score columns should be mapped."
msgstr "请选择学生标识列、标识类型和成绩列的映射方式。"

msgid ""
"Choose the identifier column/type and score column, then refresh the preview."
msgstr "请选择学生标识列/类型和成绩列，然后刷新预览。"

msgid "Class"
msgstr "课程班"

msgid "Class Name"
msgstr "课程名称"

#, php-format
msgid "Clears: %s"
msgstr "清除：%s"

#, php-format
msgid "Column %s"
msgstr "第 %s 列"

msgid "Comment"
msgstr "评语"

msgid "Comment Column"
msgstr "评语列"

msgid "Confirm Import Mapping"
msgstr "确认导入字段映射"

msgid "Confirm Publication"
msgstr "确认发布"

msgid "Confirm that unmatched or invalid import rows will be skipped."
msgstr "请确认未匹配或无效的导入行将被跳过。"

msgid "Confirm the students who will be published without a score."
msgstr "请确认将无成绩发布的学生。"

msgid "Continue"
msgstr "继续"

msgid ""
"Correct the detected columns before applying imported values. The preview "
"updates only after Refresh Preview."
msgstr "应用导入值前请修正识别出的列；只有点击“刷新预览”后预览才会更新。"

msgid "Correct these assessment details before publishing:"
msgstr "发布前请修正以下评估信息："

msgid "Create Internal Assessment"
msgstr "创建内部评估"

msgid "Create New Assessment"
msgstr "创建新评估"

msgid "Date"
msgstr "日期"

msgid "Description"
msgstr "说明"

msgid "Detected mapping"
msgstr "自动识别结果"

#, php-format
msgid ""
"Discard %s? This permanently removes the private draft and cannot be undone."
msgstr "确定丢弃“%s”吗？此操作将永久删除该私有草稿，且无法撤销。"

msgid "Discard Draft"
msgstr "丢弃草稿"

msgid "Discard this draft? This cannot be undone."
msgstr "确定丢弃此草稿吗？此操作无法撤销。"

msgid "Discard this private draft and return to the draft list."
msgstr "丢弃此私有草稿并返回草稿列表。"

msgid "Download XLSX Template"
msgstr "下载 XLSX 模板"

msgid "Draft discarded."
msgstr "草稿已丢弃。"

msgid "Draft saved."
msgstr "草稿已保存。"

msgid "Draft saved. Review the current roster and scores before publishing."
msgstr "草稿已保存。发布前请复核当前名册和成绩。"

msgid ""
"Drafts are private to their creator and are hidden from students, parents "
"and reports."
msgstr "草稿仅创建人可见，不会出现在学生、家长和报表中。"

msgid "Duplicate student"
msgstr "学生重复"

msgid "Edit Draft"
msgstr "编辑草稿"

#, php-format
msgid "Enter a score from 0 to %s."
msgstr "请输入 0 到 %s 之间的成绩。"

msgid "Enter a score of 0 or greater."
msgstr "请输入大于或等于 0 的成绩。"

msgid "Enter a valid finite number."
msgstr "请输入有效的有限数值。"

msgid "Enter an assessment name."
msgstr "请输入评估名称。"

msgid "Entered"
msgstr "已录入"

msgid "Existing"
msgstr "现有值"

msgid ""
"Export the current scores, edit the XLSX file, then import it back. Import "
"changes are previewed before they are applied."
msgstr "导出当前成绩，编辑 XLSX 文件后再导入。导入的变更会先预览，确认后才会应用。"

msgid "Export Current Scores (XLSX)"
msgstr "导出当前成绩（XLSX）"

#, php-format
msgid "Extra unmapped columns ignored: %s."
msgstr "已忽略的未映射额外列：%s。"

msgid "Formula cells cannot be imported."
msgstr "无法导入公式单元格。"

msgid "Grading scale:"
msgstr "评分标准："

#, php-format
msgid "I confirm that %s students will be published without a score."
msgstr "我确认有 %s 名学生将在无成绩的情况下发布。"

msgid ""
"I reviewed the current roster and understand that only current students will "
"be published."
msgstr "我已复核当前名册，并了解仅当前学生会发布。"

#, php-format
msgid "I understand that %s invalid or unmatched rows will not be applied."
msgstr "我了解 %s 行无效或未匹配的数据不会被应用。"

msgid "Identifier"
msgstr "标识"

msgid "Identifier Column"
msgstr "学生标识列"

msgid "Identifier Type"
msgstr "标识类型"

msgid "Import Scores"
msgstr "导入成绩"

msgid "Import Scores into Draft"
msgstr "将成绩导入草稿"

msgid ""
"Import parsed. Review the detected columns before applying it to the draft."
msgstr "导入内容已解析。应用前请复核识别出的列。"

msgid "Imported"
msgstr "导入值"

msgid "Imported score values applied to the draft."
msgstr "导入的成绩值已应用到草稿。"

msgid "Invalid"
msgstr "无效"

msgid "Invalid row"
msgstr "无效行"

msgid "Last Saved"
msgstr "最后保存"

#, php-format
msgid "Last saved %s · revision %s"
msgstr "最后保存于 %s · 修订版本 %s"

msgid "Manual value preserved"
msgstr "已保留手工值"

msgid "Matched"
msgstr "已匹配"

msgid "Maximum 1000 characters."
msgstr "最多 1000 个字符。"

msgid "Maximum 30 characters."
msgstr "最多 30 个字符。"

msgid "Missing"
msgstr "未填"

msgid "My Classes"
msgstr "我的课程"

msgid "My Score Log Drafts"
msgstr "我的成绩录入草稿"

msgid "Name"
msgstr "名称"

msgid "New"
msgstr "新增"

#, php-format
msgid "New students: %s"
msgstr "新增学生：%s"

msgid "No"
msgstr "否"

msgid "No change"
msgstr "无变更"

msgid "No header row was required; columns were detected from the data."
msgstr "无需标题行；已根据数据识别列。"

msgid "No submitted data was received."
msgstr "没有收到提交的数据。"

msgid "Only CSV and XLSX files are supported."
msgstr "仅支持 CSV 和 XLSX 文件。"

msgid "Only current students appear in the publish review."
msgstr "发布复核仅显示当前学生。"

msgid ""
"Only the current roster will be published. Review all missing scores before "
"continuing."
msgstr "仅当前名册会发布。继续前请复核所有未填成绩。"

msgid "Optional. Extra columns are ignored."
msgstr "可选，额外列将被忽略。"

msgid "Overwrite or Clear Existing Values"
msgstr "覆盖或清除现有值"

#, php-format
msgid "Overwrites: %s"
msgstr "覆盖：%s"

msgid "Parse Import"
msgstr "解析导入"

msgid "Paste from Spreadsheet"
msgstr "从电子表格粘贴"

msgid "Paste tab-separated rows. Leave the file field empty."
msgstr "粘贴制表符分隔的行；文件字段请留空。"

msgid "Pasted table"
msgstr "粘贴的表格"

msgid "Please select..."
msgstr "请选择……"

msgid "Preserved Manual Values"
msgstr "保留手工值"

msgid ""
"Private drafts created by you for the current school year. Only you can "
"resume or discard them."
msgstr "本学年由您创建的私有草稿。只有您可以继续编辑或丢弃。"

msgid "Progress"
msgstr "进度"

msgid "Publish Assessment"
msgstr "发布评估"

msgid "Publish Preview"
msgstr "发布预览"

msgid "Publish Settings"
msgstr "发布设置"

#, php-format
msgid "Publish this assessment to the current roster of %s students?"
msgstr "确定向当前名册中的 %s 名学生发布此评估吗？"

msgid "Recent Assessments"
msgstr "最近评估"

msgid "Refresh Preview"
msgstr "刷新预览"

#, php-format
msgid "Removed students: %s"
msgstr "移除学生：%s"

msgid "Resume Draft"
msgstr "继续编辑草稿"

msgid "Review and Publish"
msgstr "复核并发布"

msgid "Revision"
msgstr "修订版本"

msgid "Row"
msgstr "行"

msgid "Rows"
msgstr "数据行"

msgid "Save Draft"
msgstr "保存草稿"

msgid ""
"Save this draft before using score import or export from Saved Drafts. "
"Import changes are previewed before they are applied."
msgstr "请先保存此草稿，再从“已保存草稿”使用成绩导入或导出。导入的变更会先预览，确认后才会应用。"

msgid "Saved Drafts"
msgstr "已保存草稿"

msgid "Score"
msgstr "分值"

msgid "Score Column"
msgstr "成绩列"

msgid "Scores"
msgstr "成绩"

msgid "Skipped / Invalid"
msgstr "跳过 / 无效"

msgid "Start New Assessment"
msgstr "开始新评估"

msgid "Status"
msgstr "状态"

msgid "Student"
msgstr "学生"

msgid "Student ID"
msgstr "学生编号"

msgid "Student Name"
msgstr "学生姓名"

msgid "Students"
msgstr "学生"

msgid "The 10 most recent published internal assessments for this class."
msgstr "最近创建的 10 条内部评估，按完成日期倒序排列。"

msgid ""
"The assessment is hidden from students, parents and reports until this date."
msgstr "在这个日期之前，学生、家长和报表看不到该评估。"

msgid "The assessment name must be 30 characters or fewer."
msgstr "评估名称不得超过 30 个字符。"

msgid "The class roster changed after review. Review the current roster again."
msgstr "复核后课程班名册发生变化，请重新复核当前名册。"

msgid "The class roster changed since this draft was saved."
msgstr "保存草稿后课程班名册发生变化。"

msgid "The comment must be 1000 characters or fewer."
msgstr "评语不得超过 1000 个字符。"

msgid "The description must be 1000 characters or fewer."
msgstr "说明不得超过 1000 个字符。"

msgid ""
"The draft changed after the import preview. Reopen the draft and import "
"again."
msgstr "导入预览后草稿已发生变化，请重新打开草稿并再次导入。"

msgid "The draft is no longer available or its data is invalid."
msgstr "草稿已不可用或数据无效。"

msgid "The identifier and score must use different columns."
msgstr "学生标识列和成绩列不能是同一列。"

msgid "The import data is invalid or empty."
msgstr "导入数据无效或为空。"

msgid "The import exceeds the file, row or paste-size limit."
msgstr "导入内容超过文件、行数或粘贴大小限制。"

msgid ""
"The import mapping changed after preview. Refresh the preview before "
"applying."
msgstr "预览后导入映射已变化，请刷新预览后再应用。"

msgid "The specified record does not exist."
msgstr "指定的记录不存在。"

msgid "The spreadsheet could not be read."
msgstr "无法读取电子表格。"

msgid "The student identifier is ambiguous."
msgstr "学生标识匹配不唯一。"

msgid "The student identifier is unknown."
msgstr "未找到该学生标识。"

msgid "The submitted data is invalid. Check the class, scale and scores."
msgstr "提交的数据无效，请检查课程、评分标准和成绩。"

msgid "There are no records to display."
msgstr "没有可显示的记录。"

msgid ""
"This draft cannot be published until all invalid rows and assessment details "
"are corrected."
msgstr "修正所有无效行和评估信息后才能发布此草稿。"

msgid "This draft changed in another tab. Reopen it before continuing."
msgstr "草稿已在另一个标签页中更改，请重新打开后再继续。"

msgid "This draft changed in another tab. Reopen it before publishing."
msgstr "草稿已在另一个标签页中更改，请重新打开后再发布。"

msgid ""
"This import would not change the draft. Adjust the mapping or overwrite "
"setting if necessary."
msgstr "此次导入不会改变草稿。如有需要，请调整映射或覆盖设置。"

msgid "This legacy action is no longer available. Start or resume a draft."
msgstr "此旧版操作已不可用。请新建或继续编辑草稿。"

msgid "Type"
msgstr "类型"

msgid ""
"Unable to save. Another assessment may be in progress; try again shortly."
msgstr "保存失败，可能另一个评估正在创建，请稍后重试。"

msgid ""
"Unchecked preserves existing values. Checked overwrites changed values and "
"clears an existing mapped Score or Comment when the imported cell is blank."
msgstr ""
"未勾选时保留现有值；勾选后，将覆盖发生变化的导入值，并在导入的成绩或评语单元"
"格为空时清除对应的现有值。"

msgid "Unknown student"
msgstr "未知学生"

msgid "Unmapped"
msgstr "未映射"

msgid "Untitled draft"
msgstr "未命名草稿"

msgid ""
"Upload CSV/XLSX or paste from a spreadsheet. Two columns are enough: student "
"name/ID/username and score. A third column may contain comments."
msgstr ""
"上传 CSV/XLSX，或从电子表格粘贴。两列即可：学生姓名/编号/用户名和成绩；第三列"
"可放评语。"

msgid "Username"
msgstr "用户名"

msgid "View / Enter Marks"
msgstr "查看/录入成绩"

msgid "View Marks"
msgstr "查看成绩"

msgid "Viewable to Parents"
msgstr "家长可见"

msgid "Viewable to Students"
msgstr "学生可见"

msgid "Visible to Parents"
msgstr "家长可见"

msgid "Visible to Students"
msgstr "学生可见"

msgid "Would Clear"
msgstr "将清除"

msgid "Would Fill"
msgstr "将填入"

msgid "Would Overwrite"
msgstr "将覆盖"

msgid "Would clear"
msgstr "将清除"

msgid "Would fill"
msgstr "将填入"

msgid "Would overwrite"
msgstr "将覆盖"

msgid "Yes"
msgstr "是"

msgid "You do not have access to this page."
msgstr "您没有权限访问该页面。"

msgid "You do not have any saved drafts."
msgstr "您没有已保存的草稿。"

msgid "You do not have permission to perform this action."
msgstr "您没有权限执行该操作。"

msgid "Your session expired. Refresh the page and try again."
msgstr "会话已过期，请刷新页面后重试。"

msgid "Save and Import Scores"
msgstr "保存并导入成绩"

msgid "Save and Export Current Scores"
msgstr "保存并导出当前成绩"
